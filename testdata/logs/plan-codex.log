func (s *Service) Finalize(ctx context.Context, inv *Invoice) error {
	if inv.Status != StatusOpen {
		return ErrNotOpen
	}
	charge, err := s.payments.ChargeCard(ctx, inv.CustomerID, inv.Total)
	if err != nil {
		return fmt.Errorf("charge %s: %w", inv.ID, err)
	}
	return s.ledger.Post(ctx, Entry{InvoiceID: inv.ID, ChargeID: charge.ID, Amount: inv.Total})
}

